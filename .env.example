# ============================================================
# VoiceBento 환경변수
# ============================================================
# 로컬: 이 파일을 .env.local 로 복사하고 값을 채우세요.
# 스택으로 띄울 때: config/voicebento.env 를 읽습니다.

# --- DB / 작업 폴더 ---
DATABASE_PATH=./data/voicebento.db
# 전사하는 동안 쓰는 임시 파일 자리. 원본과 16kHz WAV 가 여기 잠깐 산다.
# 한 시간짜리면 WAV 만 115MB 다 (16000 × 2바이트 × 3600초). 볼륨에 두세요.
WORK_DIR=./data/work
# 전사 모델(671MB)이 풀려 있는 자리. 이미지에 굽지 않고 여기 둡니다.
#   npm run model:fetch   (도커에서는 진입점이 알아서 부릅니다)
MODEL_DIR=./data/models
# 스택(bento)에 얹힌 배포는 모델을 호스트가 미리 받아 **읽기 전용**으로 물립니다.
# 그때는 아래 둘이 위의 MODEL_DIR 을 이기고, 앱은 아무것도 내려받지 않습니다.
# 그 배포에서는 VAD 가 모델 폴더 밖에 있어 자리를 따로 받습니다.
#   ASR_MODEL_DIR=/models/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8
#   VAD_MODEL_PATH=/models/silero_vad.onnx
ASR_MODEL_DIR=
VAD_MODEL_PATH=
# 업로드 1개당 최대 크기 (MB). 조각 전송이라 메모리와 무관하게 키울 수 있습니다.
MAX_UPLOAD_MB=5120

# --- 파일 저장소: MemoBento (필수) ---
# 올린 소리·영상은 이 앱이 아니라 MemoBento 의 예약 메모함에 삽니다.
# 이 앱은 파일 id 만 들고 있고, 재생도 그쪽으로 프록시합니다.
#
# 주소가 **둘**입니다. 하나로 합치지 마세요.
#
# MEMOBENTO_URL — 사람이 누르는 버튼의 주소. 바깥에서 닿는 주소여야 합니다.
#   **한 도메인을 경로로 나눠 쓰는 배포라면 경로까지 적으세요.**
#   MEMOBENTO_URL=https://bento.example.com/memo
MEMOBENTO_URL=
#
# MEMOBENTO_API_URL — 이 앱의 **서버**가 파일을 주고받을 주소. 있으면 이깁니다.
#   컨테이너끼리는 서비스 이름으로 곧바로 닿습니다:
#   MEMOBENTO_API_URL=http://memobento:3000
#   이 값을 안 주고 바깥 주소로 파일을 나르면 요청이 터널을 한 바퀴 돌아
#   나갔다 들어오면서 Cloudflare 무료 플랜의 100MB 한계와 Access 로그인
#   화면을 만납니다. 한 시간짜리 녹음은 대개 그 한계를 넘습니다.
MEMOBENTO_API_URL=
# MemoBento 의 AUTH_PASSWORD. 그쪽 인증이 꺼져 있으면 비워 두세요.
MEMOBENTO_PASSWORD=
# 파일을 넣을 메모함. 비우면 아래 KEY 로 찾습니다.
# 예약 메모함을 MemoBento 쪽에 만들기 전이라면 여기에 기존 메모함 id 를
# 적어 두면 그때까지도 돕니다 (예: sys-agent-inbox).
MEMOBENTO_NOTEBOOK_ID=
MEMOBENTO_NOTEBOOK_KEY=voice

# --- 자매 앱 링크 (선택) ---
# 머리말의 건너가기 버튼. 비우면 접속한 호스트에서 유추하지만,
# 한 도메인을 경로로 나눠 쓰는 배포는 유추로 못 맞히니 적어야 합니다.
#   MAILBENTO_URL=https://bento.example.com/mail
#   PAPERBENTO_URL=https://bento.example.com/paper
MAILBENTO_URL=
PAPERBENTO_URL=

# --- 전사 ---
# 동시에 돌릴 전사 개수 (1~3, 기본 1).
# 워커 하나가 물리 4코어를 numThreads=4 로 이미 다 씁니다. 둘을 나란히
# 돌리면 처리량은 그대로인데 각자 두 배로 느려지고, 메모리는 1.6GB → 3.2GB 가
# 됩니다. 짧은 녹음이 긴 것 뒤에서 기다리는 것이 정말 거슬릴 때만 2로.
TRANSCRIBE_CONCURRENCY=1
# 조각마다 쓸 스레드 수. uno 실측으로 4가 가장 빠릅니다 (8은 2보다도 느림).
# 다른 기계에 옮길 때만 손대세요.
ASR_NUM_THREADS=4
# 같은 값의 다른 이름. 설치 마법사가 적는 것이 이쪽이라 있으면 먼저 봅니다.
ASR_THREADS=
# ffmpeg 실행 파일. 도커 이미지에는 정적 바이너리가 들어 있습니다.
FFMPEG_PATH=ffmpeg
# 컨테이너가 뜰 때 모델을 자동으로 내려받을지 (도커 진입점에서만 봅니다).
AUTO_FETCH_MODEL=1

# --- 에이전트 (선택) ---
# BentoAgent 의 HTTP 입구. 둘 다 채워야 다듬기·요약·대화가 켜집니다.
# 브라우저가 직접 부르지 않고 이 앱이 서버에서 프록시하므로 토큰은
# 노출되지 않습니다.
AGENT_URL=http://127.0.0.1:4000
AGENT_TOKEN=
# 에이전트 입구가 한 번에 받는 본문 상한 (KB). 전사문 전체를 한 덩어리로
# 넘기므로 여기 걸릴 수 있습니다. 넘치면 조용히 자르지 않고 413 을 줍니다.
AGENT_MAX_BODY_KB=512

# --- 인증 (선택) ---
# 둘 다 비워두면 인증 비활성 (앱 그대로 공개).
#
# AUTH_PASSWORD: plaintext 또는 bcrypt 해시 ($2a$ / $2b$ 시작) 둘 다 자동 감지.
AUTH_PASSWORD=
# AUTH_SECRET: 세션 쿠키 암호화 키 (32바이트 base64).
#   **형제 앱들과 같은 값이어야 합니다** — 한 도메인에 얹으면 쿠키를 함께
#   쓰기 때문입니다. 다르면 서로 로그인을 쫓아냅니다.
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- 하위 경로 배포 (선택, 빌드 시점) ---
# `.env.local` 이 아니라 이미지를 만들 때 넘겨야 합니다 — Next 가 이 값을
# 산출물 곳곳에 미리 심어서 런타임에는 바꿀 수 없습니다.
#   docker build --build-arg BASE_PATH=/voice .
# BASE_PATH=/voice
